# Copy to .env. Pick ONE backend.

# Option A: self-hosted Docker backend (see docker-compose.yml)
VITE_BRO_BACKEND_URL=http://localhost:8080
# Must match the server's CLIENT_TOKEN, if you set one
VITE_BRO_CLIENT_TOKEN=

# Option B: Firebase. Leave VITE_BRO_BACKEND_URL empty and fill these from
# Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FUNCTIONS_REGION=us-central1
# Optional: Firebase emulator, e.g. http://127.0.0.1:5001/<project-id>/us-central1
VITE_FUNCTIONS_BASE_URL=
