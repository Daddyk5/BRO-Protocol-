# Where the web server forwards /api/bro/* (the backend in ../server). Default: http://localhost:8080
BRO_BACKEND_INTERNAL_URL=http://localhost:8080
# Optional: make the browser call a backend directly instead of through the proxy.
NEXT_PUBLIC_BRO_BACKEND_URL=
# Only if the server sets CLIENT_TOKEN.
NEXT_PUBLIC_BRO_CLIENT_TOKEN=
