# Copy to .env (next to docker-compose.yml's env_file) and fill in.
# Set ANTHROPIC_API_KEY, OLLAMA_URL, or both. With both, Ollama answers first
# and Claude takes over when Ollama is down or breaks the rules.
ANTHROPIC_API_KEY=
# Local Ollama server. From Docker use http://host.docker.internal:11434;
# with `npm start` use http://localhost:11434.
OLLAMA_URL=

# Optional model overrides (defaults: claude-opus-5-5 / llama3.2:3b).
CLAUDE_MODEL=
OLLAMA_MODEL=

PORT=8080
# Each reply written counts once (asking for 3 options uses 3).
RATE_LIMIT_PER_HOUR=20
# Where counters are saved so restarts don't reset them (docker-compose sets /data/rate-limits.json).
RATE_LIMIT_FILE=
# Optional shared token: when set, clients must send `X-Bro-Client: <token>`.
# Build the app with --dart-define=BRO_CLIENT_TOKEN=... and the extension with VITE_BRO_CLIENT_TOKEN=...
CLIENT_TOKEN=
