# Copy to .env (next to docker-compose.yml's env_file) and fill in.
ANTHROPIC_API_KEY=
# Optional: use a local Ollama model instead of Claude (ANTHROPIC_API_KEY not needed).
# From Docker use http://host.docker.internal:11434; with `npm start` use http://localhost:11434.
# Set LLM_MODEL to an installed model (`ollama list`); it defaults to llama3.2:3b.
OLLAMA_URL=
# Optional
# Blank = claude-opus-5-5 (Claude) or llama3.2:3b (Ollama)
LLM_MODEL=
PORT=8080
RATE_LIMIT_PER_HOUR=20
# Optional shared token: when set, clients must send `X-Bro-Client: <token>`.
# Build the app with --dart-define=BRO_CLIENT_TOKEN=... and the extension with VITE_BRO_CLIENT_TOKEN=...
CLIENT_TOKEN=
