# Copy to .env (next to docker-compose.yml's env_file) and fill in.
ANTHROPIC_API_KEY=
# Optional
LLM_MODEL=claude-opus-5-5
PORT=8080
RATE_LIMIT_PER_HOUR=20
# Optional shared token: when set, clients must send `X-Bro-Client: <token>`.
# Build the app with --dart-define=BRO_CLIENT_TOKEN=... and the extension with VITE_BRO_CLIENT_TOKEN=...
CLIENT_TOKEN=
